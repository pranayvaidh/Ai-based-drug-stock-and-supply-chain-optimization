# Copy to .env  (cp .env.example .env  /  Copy-Item .env.example .env)
# ---- Flask API (Module 1 + 2) ----
MONGO_URI=mongodb://localhost:27017
MONGO_DB=drug_supply_chain
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_EXPIRES_MINUTES=60
CORS_ORIGIN=http://localhost:5173
API_PORT=5050
# ---- ML service (Module 3, standalone) ----
ML_SERVICE_URL=http://localhost:5051
ML_SERVICE_KEY=dev-ml-service-key
ML_PORT=5051
